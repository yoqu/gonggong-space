{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "共工空间",
  "version": "0.2.0",
  "identifier": "cn.gonggong.daemon",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "共工空间",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["gonggong"] }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBKEY",
      "endpoints": ["https://github.com/yoqu/gonggong-space/releases/latest/download/latest.json"]
    }
  }
}
