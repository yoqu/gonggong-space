{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "deep-link:default",
    "clipboard-manager:allow-read-text",
    "updater:default",
    "process:allow-restart"
  ]
}
