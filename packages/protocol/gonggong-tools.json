[
  {
    "name": "list_messages",
    "title": "读取聊天记录",
    "description": "按时间顺序读取群聊记录（人的发言与 bot 的最终回复）。消息以 #seq 标识；用 before / after / around 翻页或定位。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "description": "群 id（get_group_info 列出）；省略 = 当前会话"
        },
        "before": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "取 #seq 之前的消息"
        },
        "after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "取 #seq 之后的消息"
        },
        "around": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "取 #seq 前后的消息（含它本身）"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "条数，默认 20"
        },
        "author": {
          "type": "string",
          "description": "只看该作者（人或 bot 名字，包含匹配）"
        },
        "since": {
          "type": "string",
          "description": "起始时间，ISO 8601"
        },
        "until": {
          "type": "string",
          "description": "截止时间，ISO 8601"
        }
      }
    }
  },
  {
    "name": "search_messages",
    "title": "检索聊天记录",
    "description": "按关键词检索聊天记录，返回命中片段（从新到旧）；group=all 检索你所在的所有群。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "关键词（不区分大小写的包含匹配）"
        },
        "group": {
          "type": "string",
          "description": "群 id，或 all = 所有可读的群；省略 = 当前会话"
        },
        "author": {
          "type": "string",
          "description": "只看该作者（人或 bot 名字，包含匹配）"
        },
        "since": {
          "type": "string",
          "description": "起始时间，ISO 8601"
        },
        "until": {
          "type": "string",
          "description": "截止时间，ISO 8601"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "条数，默认 10"
        }
      },
      "required": ["query"]
    }
  },
  {
    "name": "get_group_info",
    "title": "群信息与成员",
    "description": "群名、公告、模式、绑定仓库、成员（人与 bot 及其状态），以及你还能读取的其他群。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "description": "群 id（get_group_info 列出）；省略 = 当前会话"
        }
      }
    }
  },
  {
    "name": "get_run",
    "title": "查看运行记录",
    "description": "bot 某一轮的触发消息、状态、摘要、改动文件、用量、提问与回答；include_patch 附带 diff。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "bot 回复消息的 #seq"
        },
        "run": {
          "type": "string",
          "description": "运行 id"
        },
        "include_patch": {
          "type": "boolean",
          "description": "附带本轮 diff"
        }
      }
    }
  },
  {
    "name": "list_questions",
    "title": "提问卡片历史",
    "description": "群里过往的提问卡片与群成员的回答，复用已拍板的决策。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "description": "群 id（get_group_info 列出）；省略 = 当前会话"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "条数，默认 10"
        }
      }
    }
  },
  {
    "name": "fetch_attachments",
    "title": "下载历史附件",
    "description": "把某条消息的附件下载到工作区 .gonggong/attachments/ 下，返回相对路径。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "消息 #seq"
        }
      },
      "required": ["message"]
    }
  }
]
