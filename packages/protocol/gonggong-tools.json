[
  {
    "name": "list_messages",
    "title": "读取聊天记录",
    "description": "按时间顺序读取群聊记录（人的发言与 bot 的最终回复）。消息以 #seq 标识；用 before / after / around 翻页或定位。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "description": "群 id（get_group_info 列出）；省略 = 当前会话"
        },
        "before": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "取 #seq 之前的消息"
        },
        "after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "取 #seq 之后的消息"
        },
        "around": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "取 #seq 前后的消息（含它本身）"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "条数，默认 20"
        },
        "author": {
          "type": "string",
          "description": "只看该作者（人或 bot 名字，包含匹配）"
        },
        "since": {
          "type": "string",
          "description": "起始时间，ISO 8601"
        },
        "until": {
          "type": "string",
          "description": "截止时间，ISO 8601"
        }
      }
    }
  },
  {
    "name": "search_messages",
    "title": "检索聊天记录",
    "description": "按关键词检索聊天记录，返回命中片段（从新到旧）；group=all 检索你所在的所有群。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "关键词（不区分大小写的包含匹配）"
        },
        "group": {
          "type": "string",
          "description": "群 id，或 all = 所有可读的群；省略 = 当前会话"
        },
        "author": {
          "type": "string",
          "description": "只看该作者（人或 bot 名字，包含匹配）"
        },
        "since": {
          "type": "string",
          "description": "起始时间，ISO 8601"
        },
        "until": {
          "type": "string",
          "description": "截止时间，ISO 8601"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "条数，默认 10"
        }
      },
      "required": ["query"]
    }
  },
  {
    "name": "get_group_info",
    "title": "群信息与成员",
    "description": "群名、公告、模式、绑定仓库、成员（人与 bot 及其状态），以及你还能读取的其他群。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "description": "群 id（get_group_info 列出）；省略 = 当前会话"
        }
      }
    }
  },
  {
    "name": "get_run",
    "title": "查看运行记录",
    "description": "bot 某一轮的触发消息、状态、摘要、改动文件、用量、提问与回答；include_patch 附带 diff。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "bot 回复消息的 #seq"
        },
        "run": {
          "type": "string",
          "description": "运行 id"
        },
        "include_patch": {
          "type": "boolean",
          "description": "附带本轮 diff"
        }
      }
    }
  },
  {
    "name": "list_questions",
    "title": "提问卡片历史",
    "description": "群里过往的提问卡片与群成员的回答，复用已拍板的决策。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "description": "群 id（get_group_info 列出）；省略 = 当前会话"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "条数，默认 10"
        }
      }
    }
  },
  {
    "name": "fetch_attachments",
    "title": "下载历史附件",
    "description": "把某条消息的附件下载到工作区 .gonggong/attachments/ 下，返回相对路径。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "消息 #seq"
        }
      },
      "required": ["message"]
    }
  },
  {
    "name": "list_feishu_messages",
    "title": "读取飞书群消息",
    "description": "实时读取当前群绑定的飞书群的近期消息（以触发人的飞书身份读取，结果不保存）。飞书里只有与 Bot 交互的消息会同步到共工，需要了解飞书群里此前的讨论时用它。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "条数，默认 20"
        },
        "before": {
          "type": "string",
          "description": "取该时间之前的消息，ISO 8601（上一页末尾给出）"
        }
      }
    }
  },
  {
    "name": "preview_expose",
    "title": "发布预览",
    "description": "把本机端口上的网页或服务发布给群成员：返回预览链接，并在群里发一张可内嵌打开的预览卡片。服务请先用 service_start 启动。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "本机端口"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "description": "service_start 启动的服务名，使用它的端口"
        },
        "miniprogram": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "小程序项目在本机的绝对路径；由 preview_miniprogram 填写，不要直接使用"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "卡片标题，说明这是什么"
        },
        "path": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^\\/",
          "description": "打开时的路径（以 / 开头，可带查询串），默认 /"
        }
      },
      "required": ["title"]
    }
  },
  {
    "name": "preview_gui",
    "title": "发布桌面应用预览",
    "description": "把 service_start 启动的桌面应用（如 Electron、Tauri 应用）的窗口实时推给群成员：群里出现一张预览卡片，成员打开后看到实时画面，经 Bot 主人同意可以远程操作。只推这个服务进程的窗口，不推整个屏幕。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "description": "service_start 启动的桌面应用服务名，推送它的窗口"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "卡片标题，说明这是什么"
        }
      },
      "required": ["service", "title"]
    }
  },
  {
    "name": "preview_close",
    "title": "关闭预览",
    "description": "关闭一个预览链接（服务本身不停止）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "preview": {
          "type": "string",
          "description": "preview_expose 返回的预览 id"
        }
      },
      "required": ["preview"]
    }
  },
  {
    "name": "progress_card",
    "title": "进度卡片",
    "description": "在群里发一张可实时更新的进度卡片（如构建、部署），之后传 id 更新同一张（后续轮次也可以）；只更新传入的字段。适合轮询外部状态的长任务，结束时把阶段标为完成或失败并写明原因。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "要更新的卡片 id（上次 progress_card 返回）；不传则新建一张"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "标题，如「部署 luke-server 到 test」；新建时必填"
        },
        "stages": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "阶段名，如 排队、构建、部署、完成"
              },
              "status": {
                "type": "string",
                "enum": ["pending", "running", "done", "failed", "skipped"],
                "description": "等待 / 进行中 / 完成 / 失败 / 跳过"
              }
            },
            "required": ["name", "status"]
          },
          "description": "全部阶段及当前状态（整体替换）；新建时必填"
        },
        "percent": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ],
          "description": "总进度百分比；null 清除"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ],
          "description": "一行说明，如构建号、失败原因；null 清除"
        },
        "link": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": ["label", "url"]
            },
            {
              "type": "null"
            }
          ],
          "description": "一个链接，如构建日志、预览二维码；null 清除"
        }
      }
    }
  },
  {
    "name": "hand_off",
    "title": "交给其他 Bot",
    "description": "让另一个 Bot 接手：本轮结束后群里发出一条你 @ 它并交代任务的消息，它随即开始运行。传 group 可交给你所在其他群的 Bot。回复里写 @名字 不会让对方开始工作。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "接手的 Bot 名字（get_group_info 列出的目标群 Bot）"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "交代给它的任务：要做什么、需要的上下文、做到什么程度算完成"
        },
        "group": {
          "type": "string",
          "description": "交给其他群的 Bot 时填该群 id（get_group_info 的「其他可读的群」列出，你和它都要在该群）；省略 = 本群"
        }
      },
      "required": ["bot", "task"]
    }
  },
  {
    "name": "schedule_create",
    "title": "创建定时任务",
    "description": "在本群建定时任务：到点以发起本轮的人的名义 @ 一个 Bot 执行 prompt。用户要求定期或将来某时做某事时用它，不要自己 sleep 等待。返回接下来几次执行时间，请回报给用户核对。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "任务名称，简短说明做什么"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "到点发给执行 Bot 的完整指令：它看不到本轮对话，写清要做什么、范围和产出"
        },
        "cron": {
          "type": "string",
          "minLength": 9,
          "maxLength": 100,
          "description": "5 段 cron：分 时 日 月 周（0=周日），按 timezone 解释；如 0 9 * * 1-5 = 工作日 9:00。间隔不小于 5 分钟"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "只执行一次的时刻，带时区偏移，如 2026-10-05T09:00:00+08:00"
        },
        "timezone": {
          "type": "string",
          "description": "IANA 时区，默认 Asia/Shanghai"
        },
        "bots": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": "候选 Bot 名字（本群），按擅长程度排序；到点由第一个在线空闲的执行。默认只有你自己"
        },
        "run_options": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "model": {
                "description": "如 opus、sonnet；省略 = 默认",
                "type": "string",
                "maxLength": 100
              },
              "effort": {
                "description": "如 low、medium、high；省略 = 默认",
                "type": "string",
                "maxLength": 40
              }
            },
            "required": ["bot"]
          },
          "description": "按候选 Bot 指定模型与推理强度，用户明确要求时才填；修改时给完整列表，[] = 全部恢复默认"
        }
      },
      "required": ["name", "prompt"]
    }
  },
  {
    "name": "schedule_list",
    "title": "定时任务列表",
    "description": "本群的定时任务：id、名称、候选 Bot、执行时间、启用状态、下次执行与最近结果。",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "schedule_update",
    "title": "修改定时任务",
    "description": "修改本群的定时任务，只给要改的字段（含义同 schedule_create）。只能改你创建或候选里有你的任务。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "schedule_list 列出的任务 id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "cron": {
          "type": "string",
          "minLength": 9,
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        },
        "bots": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "run_options": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "model": {
                "description": "如 opus、sonnet；省略 = 默认",
                "type": "string",
                "maxLength": 100
              },
              "effort": {
                "description": "如 low、medium、high；省略 = 默认",
                "type": "string",
                "maxLength": 40
              }
            },
            "required": ["bot"]
          }
        },
        "enabled": {
          "type": "boolean",
          "description": "false = 暂停，true = 恢复"
        }
      },
      "required": ["id"]
    }
  },
  {
    "name": "schedule_delete",
    "title": "删除定时任务",
    "description": "删除本群的定时任务。由定时任务触发的一轮里，任务已完成使命（如等待的条件已满足）时可删除它自己。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "schedule_list 列出的任务 id"
        }
      },
      "required": ["id"]
    }
  },
  {
    "name": "skill_list",
    "title": "Skill 列表",
    "description": "本群可见的团队 Skill（平台、团队、群三层，含已停用和本群已关闭的）：名称、层级、说明、版本、是否生效（同名时下层覆盖上层）、发起人能否修改。",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "skill_get",
    "title": "读取 Skill",
    "description": "读取 Skill 的全部文件内容，可指定层级与历史版本。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Skill 名称（SKILL.md frontmatter 的 name，skill_list 可查）"
        },
        "layer": {
          "type": "string",
          "enum": ["platform", "team", "group"],
          "description": "读哪一层的同名 Skill，默认本群实际生效的那一个"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "读历史版本，默认当前版本"
        }
      },
      "required": ["name"]
    }
  },
  {
    "name": "skill_create",
    "title": "新建 Skill",
    "description": "新建团队 Skill。Skill 是一个文件夹，须有 SKILL.md，开头 YAML frontmatter：name（小写字母、数字、连字符，≤64，同层唯一）与 description（≤1024，写清做什么、何时用，agent 靠它决定是否加载）；正文写操作步骤，保持精简，细节放 references/ 按需读取，脚本放 scripts/。整个文件夹 ≤5 MB、200 个文件。需发起本轮的人是该层管理员（群/团队；平台层只读）；下一轮生效。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string",
          "enum": ["group", "team"],
          "description": "group 仅本群（默认）/ team 本团队所有群"
        },
        "files": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "content": {
                "type": "string"
              },
              "encoding": {
                "default": "utf8",
                "type": "string",
                "enum": ["utf8", "base64"]
              }
            },
            "required": ["path", "content"]
          },
          "description": "文件列表：path 为相对路径（SKILL.md、scripts/run.sh、references/api.md），二进制文件用 encoding=base64"
        }
      },
      "required": ["files"]
    }
  },
  {
    "name": "skill_update",
    "title": "修改 Skill",
    "description": "修改 Skill 的文件，每次修改生成一个新版本，格式要求同 skill_create。需发起本轮的人是该层管理员（群/团队；平台层只读）；下一轮生效。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Skill 名称（SKILL.md frontmatter 的 name，skill_list 可查）"
        },
        "layer": {
          "type": "string",
          "enum": ["group", "team"],
          "description": "group 仅本群（默认）/ team 本团队所有群"
        },
        "files": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "content": {
                "type": "string"
              },
              "encoding": {
                "default": "utf8",
                "type": "string",
                "enum": ["utf8", "base64"]
              }
            },
            "required": ["path", "content"]
          },
          "description": "新增或覆盖的文件（未列出的保留）；改 SKILL.md 的 name 即重命名"
        },
        "remove": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": "要删除的文件路径"
        }
      },
      "required": ["name"]
    }
  },
  {
    "name": "skill_delete",
    "title": "删除 Skill",
