    "inputSchema": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "maxLength": 40,
          "description": "插件 name（plugin_catalog 列出）"
        },
        "template": {
          "type": "string",
          "maxLength": 40,
          "description": "模板 id；插件没有模板时省略"
        },
        "designSystem": {
          "type": "string",
          "maxLength": 40,
          "description": "设计系统 id、auto（按需求自动挑预设）或 group:<id>（本群导入的，plugin_catalog 列出）；模板不用设计系统时省略，需要但省略时：输入框式插件用 auto，其余用第一个"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "输入项 id → 值，只填该模板的输入项；拿不准的必填项留空，卡片会提示成员补充"
        },
        "directions": {
          "type": "boolean",
          "description": "是否先出 2–3 个视觉方向让大家选，默认否"
        },
        "note": {
          "type": "string",
          "maxLength": 200,
          "description": "给群成员的一句话说明，如为什么选这个模板"
        }
      },
      "required": ["plugin"]
    }
  },
  {
    "name": "artifact_checkout",
    "title": "检出产物",
    "description": "检出本群一个托管产物（design/<slug>/ 目录，服务端为准）：本轮开跑时没有下发、需要读或改它时用。产物在下一轮开跑前检出到工作区，本轮之内不会出现；返回产物目录、当前版本和屏幕清单。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "产物 id，或标题（本群内按标题匹配）"
        }
      },
      "required": ["artifact"]
    }
  }
]
