{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/target",
      "!apps/desktop/src-tauri/gen",
      "!docs",
      "!.gonggong-dev",
      "!**/drizzle",
      "!.claude",
      "!.agents",
      "!.obsidian",
      "!**/test-results",
      "!apps/web/.vitest",
      "!design",
      "!**/playwright-report",
      "!website/.vitepress/cache",
      "!videos",
      "!website/scripts/shots-workbench.data.json",
      "!apps/web/src/ui/im/twemoji",
      "!apps/server/plugins/*/*/skills"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
